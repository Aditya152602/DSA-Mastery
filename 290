import java.util.*;

public class Main {

    // Function to check whether a subset with the given sum exists
    public static boolean subsetSum(int[] arr, int target) {

        int n = arr.length;

        // dp[i][j] means:
        // Can we make sum 'j' using the first 'i' elements?
        boolean[][] dp = new boolean[n + 1][target + 1];

        // Sum 0 is always possible using an empty subset
        for (int i = 0; i <= n; i++) {
            dp[i][0] = true;
        }

        // Fill the DP table
        for (int i = 1; i <= n; i++) {

            for (int j = 1; j <= target; j++) {

                // Do not take the current element
                dp[i][j] = dp[i - 1][j];

                // Take the current element if possible
                if (arr[i - 1] <= j) {
                    dp[i][j] = dp[i][j]
                            || dp[i - 1][j - arr[i - 1]];
                }
            }
        }

        return dp[n][target];
    }

    public static void main(String[] args) {

        int[] arr = {3, 34, 4, 12, 5, 2};

        int target = 9;

        boolean result = subsetSum(arr, target);

        System.out.println("Array: " + Arrays.toString(arr));
        System.out.println("Target Sum: " + target);

        if (result) {
            System.out.println("Subset with target sum exists.");
        } else {
            System.out.println("Subset with target sum does not exist.");
        }
    }
}
