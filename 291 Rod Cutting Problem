public class Main {

    public static int rodCutting(int[] prices, int n) {

        // dp[i] = maximum revenue for rod of length i
        int[] dp = new int[n + 1];

        // dp[0] = 0
        dp[0] = 0;

        // Calculate maximum revenue for each rod length
        for (int i = 1; i <= n; i++) {

            // Try every possible first cut
            for (int j = 1; j <= i; j++) {

                dp[i] = Math.max(
                        dp[i],
                        prices[j - 1] + dp[i - j]
                );
            }
        }

        return dp[n];
    }

    public static void main(String[] args) {

        int[] prices = {1, 5, 8, 9, 10, 17, 17, 20};

        int n = 8;

        int result = rodCutting(prices, n);

        System.out.println("Maximum Revenue = " + result);
    }
}
