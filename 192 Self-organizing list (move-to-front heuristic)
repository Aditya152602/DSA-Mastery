public class SelfOrganizingList {

    // Node of Linked List
    static class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
            this.next = null;
        }
    }

    Node head;

    // Insert element at the end
    void insert(int data) {

        Node newNode = new Node(data);

        // If list is empty
        if (head == null) {
            head = newNode;
            return;
        }

        Node temp = head;

        while (temp.next != null) {
            temp = temp.next;
        }

        temp.next = newNode;
    }

    // Search and move found element to front
    boolean search(int key) {

        // Empty list
        if (head == null) {
            return false;
        }

        // If element is already at the front
        if (head.data == key) {
            return true;
        }

        Node previous = head;
        Node current = head.next;

        // Search for the element
        while (current != null) {

            if (current.data == key) {

                // Remove current node from its position
                previous.next = current.next;

                // Move current node to front
                current.next = head;
                head = current;

                return true;
            }

            previous = current;
            current = current.next;
        }

        return false;
    }

    // Display the list
    void display() {

        Node temp = head;

        while (temp != null) {
            System.out.print(temp.data + " → ");
            temp = temp.next;
        }

        System.out.println("NULL");
    }

    public static void main(String[] args) {

        SelfOrganizingList list = new SelfOrganizingList();

        // Create list
        list.insert(10);
        list.insert(20);
        list.insert(30);
        list.insert(40);
        list.insert(50);

        System.out.println("Original List:");
        list.display();

        // Search 40
        System.out.println("\nSearching for 40...");
        list.search(40);

        System.out.println("After searching 40:");
        list.display();

        // Search 40 again
        System.out.println("\nSearching for 40 again...");
        list.search(40);

        System.out.println("After searching 40 again:");
        list.display();

        // Search 30
        System.out.println("\nSearching for 30...");
        list.search(30);

        System.out.println("After searching 30:");
        list.display();
    }
}
