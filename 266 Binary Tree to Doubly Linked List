
public class Main {

    // Node class for both the binary tree and DLL
    static class Node {
        int data;
        Node left, right;

        // Constructor to create a node
        Node(int data) {
            this.data = data;
            left = null;
            right = null;
        }
    }

    // Stores the previously processed node
    static Node previous = null;

    // Stores the head of the doubly linked list
    static Node head = null;

    // Convert binary tree to DLL using inorder traversal
    static void convertToDLL(Node root) {

        // Base case: stop if node is empty
        if (root == null) {
            return;
        }

        // First process the left subtree
        convertToDLL(root.left);

        // If this is the first node, make it the head
        if (previous == null) {
            head = root;
        } else {
            // Connect previous node to current node
            previous.right = root;

            // Connect current node to previous node
            root.left = previous;
        }

        // Update previous to the current node
        previous = root;

        // Process the right subtree
        convertToDLL(root.right);
    }

    // Print the DLL from left to right
    static void printDLL(Node head) {
        Node current = head;

        while (current != null) {
            System.out.print(current.data + " ");
            current = current.right;
        }

        System.out.println();
    }

    // Print the DLL from right to left
    static void printReverse(Node head) {

        // Find the last node
        Node current = head;

        while (current.right != null) {
            current = current.right;
        }

        // Move backwards using left pointers
        while (current != null) {
            System.out.print(current.data + " ");
            current = current.left;
        }

        System.out.println();
    }

    public static void main(String[] args) {

        // Create the binary tree:
        //
        //         2
        //        / \
        //       1   3

        Node root = new Node(2);
        root.left = new Node(1);
        root.right = new Node(3);

        // Reset pointers before conversion
        previous = null;
        head = null;

        // Convert the tree to a DLL
        convertToDLL(root);

        // Print in forward direction
        System.out.print("DLL forward: ");
        printDLL(head);

        // Print in reverse direction
        System.out.print("DLL reverse: ");
        printReverse(head);
    }
}
