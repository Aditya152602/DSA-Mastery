
import java.util.*;

class StockSpanner {

    // Stack stores pairs: [price, span]
    private Stack<int[]> stack;

    // Constructor
    public StockSpanner() {

        // Create an empty stack
        stack = new Stack<>();
    }

    // Calculate the span for the new stock price
    public int next(int price) {

        // Today's span always starts at 1
        int span = 1;

        // Remove previous prices less than or equal to today's price
        while (!stack.isEmpty() &&
               stack.peek()[0] <= price) {

            // Add the previous span to today's span
            span = span + stack.pop()[1];
        }

        // Store today's price and its calculated span
        stack.push(new int[]{price, span});

        // Return today's span
        return span;
    }

    public static void main(String[] args) {

        // Create a StockSpanner object
        StockSpanner stock = new StockSpanner();

        // Prices arriving one day at a time
        int[] prices = {100, 80, 60, 70, 60, 75, 85};

        // Process each price
        for (int price : prices) {

            // Calculate and print the span
            System.out.print(stock.next(price) + " ");
        }
    }
}
