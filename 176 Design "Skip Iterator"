public class SkipIterator {

    static class Node {

        int data;
        Node next;

        Node(int data) {
            this.data = data;
            this.next = null;
        }
    }

    static class MySkipIterator {

        Node current;
        int skip;

        MySkipIterator(Node head, int skip) {
            this.current = head;
            this.skip = skip;
        }

        boolean hasNext() {
            return current != null;
        }

        int next() {

            // Store the value we want to return
            int value = current.data;

            // Move to the next node
            current = current.next;

            // Skip 'skip' nodes
            for (int i = 0; i < skip && current != null; i++) {
                current = current.next;
            }

            return value;
        }
    }

    public static void main(String[] args) {

        // Create nodes
        Node n1 = new Node(1);
        Node n2 = new Node(2);
        Node n3 = new Node(3);
        Node n4 = new Node(4);
        Node n5 = new Node(5);
        Node n6 = new Node(6);

        // Connect nodes
        n1.next = n2;
        n2.next = n3;
        n3.next = n4;
        n4.next = n5;
        n5.next = n6;

        // Create Skip Iterator
        // Skip 2 nodes after every returned node
        MySkipIterator iterator = new MySkipIterator(n1, 2);

        // Use iterator
        while (iterator.hasNext()) {
            System.out.print(iterator.next() + " ");
        }
    }
}
