public class Main {

    // 4 possible directions:
    // Up, Down, Left, Right
    static int[][] directions = {
        {-1, 0}, // Up
        {1, 0},  // Down
        {0, -1}, // Left
        {0, 1}   // Right
    };

    public static boolean exist(char[][] board, String word) {

        int rows = board.length;
        int cols = board[0].length;

        // Try every cell as the starting point
        for (int row = 0; row < rows; row++) {

            for (int col = 0; col < cols; col++) {

                if (board[row][col] == word.charAt(0)) {

                    if (dfs(board, word, row, col, 0)) {
                        return true;
                    }
                }
            }
        }

        return false;
    }

    static boolean dfs(
            char[][] board,
            String word,
            int row,
            int col,
            int index) {

        // Base case:
        // We have matched the complete word
        if (index == word.length()) {
            return true;
        }

        // Check boundaries
        if (row < 0 || row >= board.length ||
            col < 0 || col >= board[0].length) {
            return false;
        }

        // Current cell does not match
        if (board[row][col] != word.charAt(index)) {
            return false;
        }

        // Mark current cell as visited
        char original = board[row][col];
        board[row][col] = '#';

        // Explore all 4 directions
        for (int[] direction : directions) {

            int newRow = row + direction[0];
            int newCol = col + direction[1];

            if (dfs(board, word, newRow, newCol, index + 1)) {

                // Restore before returning
                board[row][col] = original;
                return true;
            }
        }

        // BACKTRACK:
        // Restore the cell so it can be used in another path
        board[row][col] = original;

        return false;
    }

    public static void main(String[] args) {

        char[][] board = {
            {'A', 'B', 'C', 'E'},
            {'S', 'F', 'C', 'S'},
            {'A', 'D', 'E', 'E'}
        };

        String word = "ABCCED";

        boolean result = exist(board, word);

        System.out.println("Word exists: " + result);
    }
}
