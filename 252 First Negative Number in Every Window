
import java.util.*;

public class FirstNegativeInWindow {

    public static void main(String[] args) {

        // Given array
        int[] arr = {12, -1, -7, 8, -15, 30, 16, 28};

        // Window size
        int k = 3;

        // Queue stores indices of negative numbers
        Queue<Integer> q = new LinkedList<>();

        // Move the window through the array
        for (int i = 0; i < arr.length; i++) {

            // If current number is negative, store its index
            if (arr[i] < 0) {
                q.add(i);
            }

            // Start processing when the window is complete
            if (i >= k - 1) {

                // Remove negative numbers outside the window
                while (!q.isEmpty() && q.peek() <= i - k) {
                    q.poll();
                }

                // Print the first negative number
                if (q.isEmpty()) {
                    System.out.print(0 + " ");
                } else {
                    System.out.print(arr[q.peek()] + " ");
                }
            }
        }
    }
}
