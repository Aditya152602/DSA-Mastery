public class Main {

    public static int maxProfit(int[] prices, int k) {

        int n = prices.length;

        // dp[t][i] = maximum profit using at most t transactions
        // in the first i days
        int[][] dp = new int[k + 1][n];

        // Try each number of transactions
        for (int t = 1; t <= k; t++) {

            // Stores the best value of:
            // dp[t-1][j] - prices[j]
            int maxDiff = -prices[0];

            // Check every day
            for (int i = 1; i < n; i++) {

                // Option 1:
                // Do not sell today
                dp[t][i] = dp[t][i - 1];

                // Option 2:
                // Sell today
                dp[t][i] = Math.max(
                        dp[t][i],
                        prices[i] + maxDiff
                );

                // Update maxDiff for future days
                maxDiff = Math.max(
                        maxDiff,
                        dp[t - 1][i] - prices[i]
                );
            }
        }

        return dp[k][n - 1];
    }

    public static void main(String[] args) {

        int[] prices = {3, 2, 6, 5, 0, 3};
        int k = 2;

        int result = maxProfit(prices, k);

        System.out.println("Maximum Profit = " + result);
    }
}
