
import java.util.Stack;

public class Main {

    // Node class represents one node of the binary tree
    static class Node {
        int data;
        Node left, right;

        // Constructor to create a node
        Node(int data) {
            this.data = data;
            left = null;
            right = null;
        }
    }

    // 1. RECURSIVE INORDER: Left -> Root -> Right
    static void inorder(Node root) {
        if (root == null) {
            return;
        }

        inorder(root.left);
        System.out.print(root.data + " ");
        inorder(root.right);
    }

    // 2. RECURSIVE PREORDER: Root -> Left -> Right
    static void preorder(Node root) {
        if (root == null) {
            return;
        }

        System.out.print(root.data + " ");
        preorder(root.left);
        preorder(root.right);
    }

    // 3. RECURSIVE POSTORDER: Left -> Right -> Root
    static void postorder(Node root) {
        if (root == null) {
            return;
        }

        postorder(root.left);
        postorder(root.right);
        System.out.print(root.data + " ");
    }

    // 4. ITERATIVE INORDER using one stack
    static void inorderIterative(Node root) {
        Stack<Node> stack = new Stack<>();
        Node current = root;

        while (current != null || !stack.isEmpty()) {

            // Move to the leftmost node
            while (current != null) {
                stack.push(current);
                current = current.left;
            }

            // Visit the node
            current = stack.pop();
            System.out.print(current.data + " ");

            // Visit its right subtree
            current = current.right;
        }
    }

    // 5. ITERATIVE PREORDER using one stack
    static void preorderIterative(Node root) {
        if (root == null) {
            return;
        }

        Stack<Node> stack = new Stack<>();
        stack.push(root);

        while (!stack.isEmpty()) {
            Node current = stack.pop();

            // Visit the root first
            System.out.print(current.data + " ");

            // Push right before left
            if (current.right != null) {
                stack.push(current.right);
            }

            if (current.left != null) {
                stack.push(current.left);
            }
        }
    }

    // 6. ITERATIVE POSTORDER using two stacks
    static void postorderIterative(Node root) {
        if (root == null) {
            return;
        }

        Stack<Node> stack1 = new Stack<>();
        Stack<Node> stack2 = new Stack<>();

        stack1.push(root);

        while (!stack1.isEmpty()) {
            Node current = stack1.pop();

            // Store node for reverse processing
            stack2.push(current);

            // Push left child
            if (current.left != null) {
                stack1.push(current.left);
            }

            // Push right child
            if (current.right != null) {
                stack1.push(current.right);
            }
        }

        // Print nodes in postorder
        while (!stack2.isEmpty()) {
            System.out.print(stack2.pop().data + " ");
        }
    }

    // Main method: program execution starts here
    public static void main(String[] args) {

        // Create this binary tree:
        //
        //       1
        //      / \
        //     2   3

        Node root = new Node(1);
        root.left = new Node(2);
        root.right = new Node(3);

        // Recursive traversals
        System.out.println("=== Recursive Traversals ===");

        System.out.print("Inorder:   ");
        inorder(root);

        System.out.print("\nPreorder:  ");
        preorder(root);

        System.out.print("\nPostorder: ");
        postorder(root);

        // Iterative traversals
        System.out.println("\n\n=== Iterative Traversals ===");

        System.out.print("Inorder:   ");
        inorderIterative(root);

        System.out.print("\nPreorder:  ");
        preorderIterative(root);

        System.out.print("\nPostorder: ");
        postorderIterative(root);

        System.out.println();
    }
}
