public class MultiplyLinkedLists {

    static class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
            this.next = null;
        }
    }

    // Convert linked list into number
    static long toNumber(Node head) {

        long number = 0;

        Node current = head;

        while (current != null) {
            number = number * 10 + current.data;
            current = current.next;
        }

        return number;
    }

    // Create linked list from number
    static Node createList(long number) {

        if (number == 0) {
            return new Node(0);
        }

        Node head = null;
        Node tail = null;

        while (number > 0) {

            int digit = (int) (number % 10);

            Node newNode = new Node(digit);

            if (head == null) {
                head = newNode;
                tail = newNode;
            } else {
                newNode.next = head;
                head = newNode;
            }

            number = number / 10;
        }

        return head;
    }

    // Multiply two linked lists
    static Node multiply(Node head1, Node head2) {

        long num1 = toNumber(head1);
        long num2 = toNumber(head2);

        long result = num1 * num2;

        return createList(result);
    }

    // Print linked list
    static void printList(Node head) {

        Node current = head;

        while (current != null) {
            System.out.print(current.data);

            if (current.next != null) {
                System.out.print(" → ");
            }

            current = current.next;
        }

        System.out.println();
    }

    public static void main(String[] args) {

        // 1 → 2 → 3 = 123
        Node head1 = new Node(1);
        head1.next = new Node(2);
        head1.next.next = new Node(3);

        // 4 → 5 = 45
        Node head2 = new Node(4);
        head2.next = new Node(5);

        Node result = multiply(head1, head2);

        System.out.println("First number:");
        printList(head1);

        System.out.println("Second number:");
        printList(head2);

        System.out.println("Multiplication:");
        printList(result);
    }
}
