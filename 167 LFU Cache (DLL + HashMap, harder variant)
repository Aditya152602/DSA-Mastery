import java.util.HashMap;

public class Main {

    // Node
    static class Node {
        int key;
        int value;
        int frequency;

        Node prev;
        Node next;

        Node(int key, int value) {
            this.key = key;
            this.value = value;
            this.frequency = 1;
        }
    }

    // Doubly Linked List
    static class DoublyLinkedList {

        Node head;
        Node tail;
        int size;

        DoublyLinkedList() {
            head = new Node(0, 0);
            tail = new Node(0, 0);

            head.next = tail;
            tail.prev = head;

            size = 0;
        }

        // Add node at front
        void addFirst(Node node) {

            node.next = head.next;
            node.prev = head;

            head.next.prev = node;
            head.next = node;

            size++;
        }

        // Remove node
        void remove(Node node) {

            node.prev.next = node.next;
            node.next.prev = node.prev;

            size--;
        }

        // Remove least recently used node
        Node removeLast() {

            if (size == 0) {
                return null;
            }

            Node node = tail.prev;

            remove(node);

            return node;
        }
    }

    // LFU Cache
    static class LFUCache {

        int capacity;
        int minFrequency;

        // key -> Node
        HashMap<Integer, Node> keyMap;

        // frequency -> Doubly Linked List
        HashMap<Integer, DoublyLinkedList> frequencyMap;

        LFUCache(int capacity) {

            this.capacity = capacity;
            this.minFrequency = 0;

            keyMap = new HashMap<>();
            frequencyMap = new HashMap<>();
        }

        // Get value
        int get(int key) {

            if (!keyMap.containsKey(key)) {
                return -1;
            }

            Node node = keyMap.get(key);

            increaseFrequency(node);

            return node.value;
        }

        // Put key and value
        void put(int key, int value) {

            if (capacity == 0) {
                return;
            }

            // Key already exists
            if (keyMap.containsKey(key)) {

                Node node = keyMap.get(key);

                node.value = value;

                increaseFrequency(node);

                return;
            }

            // Cache is full
            if (keyMap.size() == capacity) {

                DoublyLinkedList list =
                        frequencyMap.get(minFrequency);

                Node removedNode = list.removeLast();

                keyMap.remove(removedNode.key);
            }

            // Create new node
            Node newNode = new Node(key, value);

            keyMap.put(key, newNode);

            // New node has frequency 1
            DoublyLinkedList list =
                    frequencyMap.getOrDefault(
                            1,
                            new DoublyLinkedList()
                    );

            list.addFirst(newNode);

            frequencyMap.put(1, list);

            minFrequency = 1;
        }

        // Increase frequency
        void increaseFrequency(Node node) {

            int oldFrequency = node.frequency;

            DoublyLinkedList oldList =
                    frequencyMap.get(oldFrequency);

            oldList.remove(node);

            // If this was the last node
            // with the minimum frequency
            if (oldFrequency == minFrequency
                    && oldList.size == 0) {

                minFrequency++;
            }

            node.frequency++;

            int newFrequency = node.frequency;

            DoublyLinkedList newList =
                    frequencyMap.getOrDefault(
                            newFrequency,
                            new DoublyLinkedList()
                    );

            newList.addFirst(node);

            frequencyMap.put(newFrequency, newList);
        }

        // Display cache
        void display() {

            System.out.println("Cache:");

            for (int frequency : frequencyMap.keySet()) {

                DoublyLinkedList list =
                        frequencyMap.get(frequency);

                if (list.size == 0) {
                    continue;
                }

                System.out.print(
                        "Frequency " + frequency + ": "
                );

                Node current = list.head.next;

                while (current != list.tail) {

                    System.out.print(
                            "(" + current.key
                                    + "," + current.value
                                    + ") "
                    );

                    current = current.next;
                }

                System.out.println();
            }

            System.out.println(
                    "Minimum Frequency: " + minFrequency
            );

            System.out.println();
        }
    }

    public static void main(String[] args) {

        LFUCache cache = new LFUCache(3);

        cache.put(1, 100);
        cache.put(2, 200);
        cache.put(3, 300);

        cache.display();

        System.out.println("Get 1: " + cache.get(1));

        cache.display();

        System.out.println("Get 1: " + cache.get(1));

        cache.display();

        System.out.println("Get 2: " + cache.get(2));

        cache.display();

        cache.put(4, 400);

        cache.display();
    }
}
