
import java.util.*;

public class Main {

    // Create a Node class for the binary tree
    static class Node {
        int data;
        Node left, right;

        // Constructor to initialize the node
        Node(int data) {
            this.data = data;
            left = null;
            right = null;
        }
    }

    // Function to find the right side view
    static List<Integer> rightSideView(Node root) {

        // Create a list to store the answer
        List<Integer> result = new ArrayList<>();

        // If the tree is empty, return an empty list
        if (root == null) {
            return result;
        }

        // Create a queue for level order traversal
        Queue<Node> queue = new LinkedList<>();

        // Insert the root node into the queue
        queue.offer(root);

        // Process the tree level by level
        while (!queue.isEmpty()) {

            // Get the number of nodes at the current level
            int size = queue.size();

            // Process all nodes of the current level
            for (int i = 0; i < size; i++) {

                // Remove the front node from the queue
                Node current = queue.poll();

                // If this is the last node of this level,
                // it will be visible from the right side
                if (i == size - 1) {
                    result.add(current.data);
                }

                // Add the left child if it exists
                if (current.left != null) {
                    queue.offer(current.left);
                }

                // Add the right child if it exists
                if (current.right != null) {
                    queue.offer(current.right);
                }
            }
        }

        // Return the right side view
        return result;
    }

    public static void main(String[] args) {

        // Create the binary tree
        Node root = new Node(1);

        root.left = new Node(2);
        root.right = new Node(3);

        root.left.left = new Node(4);
        root.left.right = new Node(5);

        root.right.right = new Node(7);

        root.left.right.left = new Node(6);

        // Find the right side view
        List<Integer> result = rightSideView(root);

        // Print the answer
        System.out.println("Right Side View: " + result);
    }
}
