
public class Main {

    // Node class for the binary tree
    static class Node {
        int data;
        Node left, right;

        // Constructor to create a node
        Node(int data) {
            this.data = data;
            left = null;
            right = null;
        }
    }

    // Variable to store the maximum diameter
    static int diameter = 0;

    // Calculate height and update diameter
    static int height(Node root) {

        // Base case: empty tree has height 0
        if (root == null) {
            return 0;
        }

        // Calculate height of left subtree
        int leftHeight = height(root.left);

        // Calculate height of right subtree
        int rightHeight = height(root.right);

        // Calculate diameter passing through current node
        int currentDiameter = leftHeight + rightHeight;

        // Update maximum diameter
        diameter = Math.max(diameter, currentDiameter);

        // Return height of current subtree
        return 1 + Math.max(leftHeight, rightHeight);
    }

    // Find diameter of binary tree
    static int findDiameter(Node root) {

        // Reset diameter before calculation
        diameter = 0;

        // Calculate height and diameter
        height(root);

        // Return the maximum diameter
        return diameter;
    }

    public static void main(String[] args) {

        // Create the binary tree:
        //
        //         1
        //        / \
        //       2   3
        //      / \
        //     4   5

        Node root = new Node(1);
        root.left = new Node(2);
        root.right = new Node(3);
        root.left.left = new Node(4);
        root.left.right = new Node(5);

        // Find and print diameter
        System.out.println(
            "Diameter of Binary Tree: " + findDiameter(root)
        );
    }
}
