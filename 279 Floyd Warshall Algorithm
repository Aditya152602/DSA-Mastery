
public class FloydWarshall {

    public static void floydWarshall(int[][] dist) {

        // Number of vertices
        int n = dist.length;

        // Try every vertex as an intermediate vertex
        for (int k = 0; k < n; k++) {

            // Select the source vertex
            for (int i = 0; i < n; i++) {

                // Select the destination vertex
                for (int j = 0; j < n; j++) {

                    // Check if a shorter path exists through k
                    if (dist[i][k] != Integer.MAX_VALUE &&
                        dist[k][j] != Integer.MAX_VALUE) {

                        // Calculate the new distance
                        int newDistance = dist[i][k] + dist[k][j];

                        // Update if the new path is shorter
                        if (newDistance < dist[i][j]) {
                            dist[i][j] = newDistance;
                        }
                    }
                }
            }
        }
    }

    public static void main(String[] args) {

        // Infinity represents no direct connection
        int INF = Integer.MAX_VALUE;

        // Adjacency matrix
        int[][] dist = {
            {0,   5,   INF, 10},
            {INF, 0,   3,   INF},
            {INF, INF, 0,   1},
            {INF, INF, INF, 0}
        };

        // Call Floyd Warshall algorithm
        floydWarshall(dist);

        // Print shortest distance matrix
        System.out.println("Shortest Distance Matrix:");

        for (int i = 0; i < dist.length; i++) {

            for (int j = 0; j < dist.length; j++) {

                if (dist[i][j] == INF) {
                    System.out.print("INF ");
                } else {
                    System.out.print(dist[i][j] + "   ");
                }
            }

            System.out.println();
        }
    }
}
