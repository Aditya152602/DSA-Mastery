public class UnrolledLinkedList {

    static class Node {

        int[] elements;
        int count;
        Node next;

        Node(int capacity) {
            elements = new int[capacity];
            count = 0;
            next = null;
        }
    }

    static int capacity = 3;
    static Node head = null;

    static void insert(int value) {

        if (head == null) {
            head = new Node(capacity);
            head.elements[head.count++] = value;
            return;
        }

        Node current = head;

        while (current.next != null && current.count == capacity) {
            current = current.next;
        }

        if (current.count < capacity) {

            current.elements[current.count] = value;
            current.count++;

        } else {

            Node newNode = new Node(capacity);

            newNode.elements[newNode.count++] = value;

            current.next = newNode;
        }
    }

    static void display() {

        Node current = head;

        while (current != null) {

            System.out.print("[ ");

            for (int i = 0; i < current.count; i++) {
                System.out.print(current.elements[i] + " ");
            }

            System.out.print("]");

            if (current.next != null) {
                System.out.print(" -> ");
            }

            current = current.next;
        }

        System.out.println();
    }

    public static void main(String[] args) {

        insert(10);
        insert(20);
        insert(30);
        insert(40);
        insert(50);
        insert(60);
        insert(70);

        display();
    }
}
