class Node {
    int data;
    Node next;
    Node prev;

    // Adding a constructor makes node creation cleaner
    Node(int data) {
        this.data = data;
    }
}

public class ReverseLinkedList {
    public static void main(String[] args) {
        // 1. Setup a standard sequential list: 10 <-> 20 <-> 30
        Node first = new Node(10);
        Node second = new Node(20);
        Node third = new Node(30);

        first.next = second;
        second.prev = first;
        second.next = third;
        third.prev = second;

        // 2. Algorithm to reverse the doubly linked list dynamically
        Node current = first;
        Node temp = null;

        while (current != null) {
            // Swap the next and prev pointers for the current node
            temp = current.prev;
            current.prev = current.next;
            current.next = temp;

            // Move forward in the original list 
            // (Since we swapped pointers, the "next" node is now in current.prev)
            current = current.prev; 
        }

        // 3. Reset the head to the last processed node
        if (temp != null) {
            first = temp.prev; 
        }

        // 4. Print the newly reversed list
        Node printNode = first;
        while (printNode != null) {
            System.out.println(printNode.data);
            printNode = printNode.next;
        }
    }
}
