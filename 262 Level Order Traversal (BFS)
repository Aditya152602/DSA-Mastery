
import java.util.*;

public class Main {

    // Node class for the binary tree
    static class Node {
        int data;
        Node left, right;

        // Constructor to create a node
        Node(int data) {
            this.data = data;
            left = null;
            right = null;
        }
    }

    // Level Order Traversal using BFS
    static List<List<Integer>> levelOrder(Node root) {

        // Store the final answer
        List<List<Integer>> result = new ArrayList<>();

        // If the tree is empty, return an empty list
        if (root == null) {
            return result;
        }

        // Queue processes nodes in FIFO order
        Queue<Node> queue = new LinkedList<>();

        // Add the root node to the queue
        queue.offer(root);

        // Continue until the queue becomes empty
        while (!queue.isEmpty()) {

            // Number of nodes in the current level
            int size = queue.size();

            // Store values of this level
            List<Integer> level = new ArrayList<>();

            // Process every node at this level
            for (int i = 0; i < size; i++) {

                // Remove the first node from the queue
                Node current = queue.poll();

                // Add its value to the current level
                level.add(current.data);

                // Add the left child if it exists
                if (current.left != null) {
                    queue.offer(current.left);
                }

                // Add the right child if it exists
                if (current.right != null) {
                    queue.offer(current.right);
                }
            }

            // Add this level to the final result
            result.add(level);
        }

        // Return all levels
        return result;
    }

    public static void main(String[] args) {

        // Create the following binary tree:
        //
        //         3
        //        / \
        //       9   20
        //          /  \
        //         15   7

        Node root = new Node(3);
        root.left = new Node(9);
        root.right = new Node(20);
        root.right.left = new Node(15);
        root.right.right = new Node(7);

        // Call the level order traversal method
        List<List<Integer>> answer = levelOrder(root);

        // Print the result
        System.out.println(answer);
    }
}
