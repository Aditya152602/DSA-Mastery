
import java.util.HashMap;
import java.util.Map;

// Represents one node in the doubly linked list
class Node {
    int key;
    int value;
    Node prev;
    Node next;

    // Constructor to store key and value
    Node(int key, int value) {
        this.key = key;
        this.value = value;
    }
}

// Implements the LRU Cache
class LRUCache {

    // Maximum number of items the cache can store
    private int capacity;

    // Maps each key to its corresponding node
    private Map<Integer, Node> map;

    // Dummy nodes simplify insertion and deletion
    private Node head;
    private Node tail;

    // Constructor
    public LRUCache(int capacity) {
        this.capacity = capacity;
        map = new HashMap<>();

        head = new Node(0, 0);
        tail = new Node(0, 0);

        // Initially, head and tail are connected
        head.next = tail;
        tail.prev = head;
    }

    // Removes a node from the linked list
    private void remove(Node node) {
        node.prev.next = node.next;
        node.next.prev = node.prev;
    }

    // Inserts a node immediately after head
    private void insertAtFront(Node node) {
        node.next = head.next;
        node.prev = head;

        head.next.prev = node;
        head.next = node;
    }

    // Returns the value for a key
    public int get(int key) {
        // If key does not exist, return -1
        if (!map.containsKey(key)) {
            return -1;
        }

        // Find the node
        Node node = map.get(key);

        // Mark it as recently used
        remove(node);
        insertAtFront(node);

        // Return its value
        return node.value;
    }

    // Adds or updates a key-value pair
    public void put(int key, int value) {

        // A cache with zero capacity cannot store items
        if (capacity <= 0) {
            return;
        }

        // If the key already exists, update its value
        if (map.containsKey(key)) {
            Node node = map.get(key);
            node.value = value;

            // Mark it as recently used
            remove(node);
            insertAtFront(node);
            return;
        }

        // If the cache is full, remove the least used node
        if (map.size() == capacity) {
            Node leastUsed = tail.prev;

            remove(leastUsed);
            map.remove(leastUsed.key);
        }

        // Create a new node
        Node newNode = new Node(key, value);

        // Add it to the map
        map.put(key, newNode);

        // New nodes are the most recently used
        insertAtFront(newNode);
    }
}

// Main class to test the cache
public class Main {
    public static void main(String[] args) {

        // Create a cache with capacity 2
        LRUCache cache = new LRUCache(2);

        // Insert two key-value pairs
        cache.put(1, 10);
        cache.put(2, 20);

        // Display the value for key 1
        System.out.println(cache.get(1)); // 10

        // Insert key 3; key 2 is removed
        cache.put(3, 30);

        // Key 2 no longer exists
        System.out.println(cache.get(2)); // -1

        // Insert key 4; key 1 is removed
        cache.put(4, 40);

        // Display results
        System.out.println(cache.get(1)); // -1
        System.out.println(cache.get(3)); // 30
        System.out.println(cache.get(4)); // 40
    }
}
